+// Match the request window advertised in the extended handshake. A permit
+// travels with each remote-triggered piece or metadata response until the peer
+// writer has flushed it. Admission is deliberately non-blocking: a peer that
+// exceeds the advertised window is disconnected instead of parking the socket
+// reader behind the torrent-global upload rate limiter.
+const MAX_PENDING_PEER_RESPONSES_PER_PEER: usize = 128;
+
+#[derive(Clone, Debug)]
+struct PeerResponseBudget {
+    permits: Arc<Semaphore>,
+}
+
+impl PeerResponseBudget {
+    fn new() -> Self {
+        Self {
+            permits: Arc::new(Semaphore::new(MAX_PENDING_PEER_RESPONSES_PER_PEER)),
+        }
+    }
+
+    fn try_acquire(&self) -> anyhow::Result<OwnedSemaphorePermit> {
+        self.permits
+            .clone()
+            .try_acquire_owned()
+            .context("peer exceeded advertised response window")
+    }
+
+    fn advertise(&self, handshake: &mut ExtendedHandshake<ByteBuf>) {
+        handshake.reqq = Some(MAX_PENDING_PEER_RESPONSES_PER_PEER as u32);
+    }
+}
+
+type PendingUploadRequest = (ChunkInfo, OwnedSemaphorePermit);
+
+fn enqueue_piece_response(
+    budget: &PeerResponseBudget,
+    scheduler_tx: &UnboundedSender<(UnboundedSender<WriterRequest>, PendingUploadRequest)>,
+    peer_tx: &UnboundedSender<WriterRequest>,
+    chunk: ChunkInfo,
+) -> anyhow::Result<()> {
+    let permit = budget.try_acquire()?;
+    scheduler_tx
+        .send((peer_tx.clone(), (chunk, permit)))
+        .context("upload scheduler closed")
+}
+
+fn forward_piece_response(
+    peer_tx: &UnboundedSender<WriterRequest>,
+    request: PendingUploadRequest,
+) -> anyhow::Result<()> {
+    let (chunk, permit) = request;
+    peer_tx
+        .send(WriterRequest::ReadChunkRequest(chunk, permit))
+        .context("peer writer closed")
+}
+
+fn enqueue_metadata_response(
+    budget: &PeerResponseBudget,
+    peer_tx: &UnboundedSender<WriterRequest>,
+    message: MessageOwned,
+) -> anyhow::Result<()> {
+    let permit = budget.try_acquire()?;
+    peer_tx
+        .send(WriterRequest::MessageWithPermit(message, permit))
+        .context("peer writer closed")
+}
+
 fn make_piece_bitfield(lengths: &Lengths) -> BF {
     BF::from_boxed_slice(vec![0; lengths.piece_bitfield_bytes()].into_boxed_slice())
 }
