+#[cfg(test)]
+mod peer_response_budget_tests {
+    use futures::FutureExt;
+
+    use super::*;
+
+    fn test_chunk() -> ChunkInfo {
+        let lengths = Lengths::new(1, 1).unwrap();
+        lengths
+            .iter_chunk_infos(lengths.validate_piece_index(0).unwrap())
+            .next()
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn peer_response_permit_spans_scheduler_and_writer_queues() {
+        let budget = Arc::new(Semaphore::new(MAX_PENDING_PEER_RESPONSES_PER_PEER));
+        let (scheduler_tx, mut scheduler_rx) = unbounded_channel::<PendingUploadRequest>();
+        let (writer_tx, mut writer_rx) = unbounded_channel::<WriterRequest>();
+
+        for _ in 0..MAX_PENDING_PEER_RESPONSES_PER_PEER {
+            let permit = acquire_peer_response_permit(&budget).await.unwrap();
+            scheduler_tx.send((test_chunk(), permit)).unwrap();
+        }
+
+        assert!(acquire_peer_response_permit(&budget)
+            .now_or_never()
+            .is_none());
+
+        let (chunk, permit) = scheduler_rx.recv().await.unwrap();
+        writer_tx
+            .send(WriterRequest::ReadChunkRequest(chunk, permit))
+            .unwrap();
+        assert!(acquire_peer_response_permit(&budget)
+            .now_or_never()
+            .is_none());
+
+        drop(writer_rx.recv().await.unwrap());
+        let metadata_permit = acquire_peer_response_permit(&budget)
+            .now_or_never()
+            .unwrap()
+            .unwrap();
+        writer_tx
+            .send(WriterRequest::MessageWithPermit(
+                MessageOwned::KeepAlive,
+                metadata_permit,
+            ))
+            .unwrap();
+        assert!(acquire_peer_response_permit(&budget)
+            .now_or_never()
+            .is_none());
+
+        drop(writer_rx.recv().await.unwrap());
+        assert!(acquire_peer_response_permit(&budget)
+            .now_or_never()
+            .unwrap()
+            .is_ok());
+    }
+}
