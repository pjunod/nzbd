+// Match the existing per-peer download request window. A permit travels with
+// each remote-triggered piece or metadata response until the peer writer has
+// flushed it. This gives the upload scheduler and writer queue one combined
+// finite admission budget for remotely generated work.
+const MAX_PENDING_PEER_RESPONSES_PER_PEER: usize = 128;
+
+async fn acquire_peer_response_permit(
+    permits: &Arc<Semaphore>,
+) -> anyhow::Result<OwnedSemaphorePermit> {
+    permits
+        .clone()
+        .acquire_owned()
+        .await
+        .context("peer response budget closed")
+}
