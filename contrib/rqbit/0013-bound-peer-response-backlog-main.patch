+#[cfg(test)]
+mod peer_response_writer_tests {
+    use std::{sync::Arc, time::Duration};
+
+    use tokio::sync::Semaphore;
+
+    use super::write_with_peer_response_permit;
+
+    #[tokio::test]
+    async fn production_writer_holds_permit_until_socket_write_finishes() {
+        let budget = Arc::new(Semaphore::new(1));
+        let permit = budget.clone().acquire_owned().await.unwrap();
+        let (mut write, _read) = tokio::io::duplex(1);
+
+        let writer = tokio::spawn(async move {
+            write_with_peer_response_permit(
+                &mut write,
+                &[0, 1],
+                Duration::from_secs(30),
+                Some(permit),
+            )
+            .await
+        });
+
+        tokio::task::yield_now().await;
+        assert!(budget.clone().try_acquire_owned().is_err());
+
+        writer.abort();
+        let _ = writer.await;
+        assert!(budget.try_acquire_owned().is_ok());
+    }
+}
