+#[cfg(test)]
+mod peer_response_budget_tests {
+    use super::*;
+
+    fn test_chunk() -> ChunkInfo {
+        let lengths = Lengths::new(1, 1).unwrap();
+        lengths
+            .iter_chunk_infos(lengths.validate_piece_index(0).unwrap())
+            .next()
+            .unwrap()
+    }
+
+    #[tokio::test]
+    async fn production_admission_spans_scheduler_and_writer_queues() {
+        let budget = PeerResponseBudget::new();
+        let (scheduler_tx, mut scheduler_rx) =
+            unbounded_channel::<(UnboundedSender<WriterRequest>, PendingUploadRequest)>();
+        let (writer_tx, mut writer_rx) = unbounded_channel::<WriterRequest>();
+
+        for _ in 0..MAX_PENDING_PEER_RESPONSES_PER_PEER {
+            enqueue_piece_response(&budget, &scheduler_tx, &writer_tx, test_chunk()).unwrap();
+        }
+
+        assert!(enqueue_piece_response(&budget, &scheduler_tx, &writer_tx, test_chunk()).is_err());
+
+        let (scheduled_writer, request) = scheduler_rx.recv().await.unwrap();
+        forward_piece_response(&scheduled_writer, request).unwrap();
+        assert!(budget.try_acquire().is_err());
+
+        drop(writer_rx.recv().await.unwrap());
+        enqueue_metadata_response(&budget, &writer_tx, UtMetadata::Reject(0)).unwrap();
+        assert!(budget.try_acquire().is_err());
+
+        drop(writer_rx.recv().await.unwrap());
+        assert!(budget.try_acquire().is_ok());
+
+        let mut handshake = ExtendedHandshake::new();
+        budget.advertise(&mut handshake);
+        assert_eq!(
+            handshake.reqq,
+            Some(MAX_PENDING_PEER_RESPONSES_PER_PEER as u32)
+        );
+    }
