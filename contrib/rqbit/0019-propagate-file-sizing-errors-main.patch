+#[cfg(test)]
+mod tests {
+    use std::io;
+
+    use super::{InitialCheckPaused, should_suppress_initial_check_error};
+
+    #[test]
+    fn pause_race_preserves_non_cancellation_initialization_errors() {
+        let storage_error: anyhow::Error =
+            io::Error::new(io::ErrorKind::StorageFull, "injected storage full").into();
+        assert!(!should_suppress_initial_check_error(true, &storage_error));
+
+        let pause_error = anyhow::Error::new(InitialCheckPaused);
+        assert!(should_suppress_initial_check_error(true, &pause_error));
+        assert!(!should_suppress_initial_check_error(false, &pause_error));
+    }
+}
