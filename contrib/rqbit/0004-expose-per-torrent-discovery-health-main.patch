+/// A point-in-time view of one torrent's DHT peer-discovery activity.
+///
+/// The counters describe this handle's current discovery run. They are reset
+/// whenever a new `RequestPeersStream` starts with the handle.
+#[derive(Clone, Copy, Debug, Default, Serialize, PartialEq, Eq)]
+pub struct RequestPeersHealthSnapshot {
+    pub active: bool,
+    pub successful_requests: u64,
+    pub failed_requests: u64,
+    pub peers_found: u64,
+    pub last_request_succeeded: Option<bool>,
+}
+
+#[derive(Debug, Default)]
+struct RequestPeersHealthInner {
+    active: AtomicBool,
+    successful_requests: AtomicU64,
+    failed_requests: AtomicU64,
+    peers_found: AtomicU64,
+    // 0 = no request completed, 1 = success, 2 = failure.
+    last_request_result: AtomicU16,
+}
+
+/// Shared health state for one torrent's DHT peer-discovery stream.
+#[derive(Clone, Debug, Default)]
+pub struct RequestPeersHealth {
+    inner: Arc<RequestPeersHealthInner>,
+}
+
+impl RequestPeersHealth {
+    pub fn snapshot(&self) -> RequestPeersHealthSnapshot {
+        RequestPeersHealthSnapshot {
+            active: self.inner.active.load(Ordering::Relaxed),
+            successful_requests: self.inner.successful_requests.load(Ordering::Relaxed),
+            failed_requests: self.inner.failed_requests.load(Ordering::Relaxed),
+            peers_found: self.inner.peers_found.load(Ordering::Relaxed),
+            last_request_succeeded: match self.inner.last_request_result.load(Ordering::Relaxed) {
+                1 => Some(true),
+                2 => Some(false),
+                _ => None,
+            },
+        }
+    }
+
+    fn start(&self) {
+        self.inner.active.store(true, Ordering::Relaxed);
+        self.inner.successful_requests.store(0, Ordering::Relaxed);
+        self.inner.failed_requests.store(0, Ordering::Relaxed);
+        self.inner.peers_found.store(0, Ordering::Relaxed);
+        self.inner.last_request_result.store(0, Ordering::Relaxed);
+    }
+
+    fn stop(&self) {
+        self.inner.active.store(false, Ordering::Relaxed);
+    }
+
+    fn record_request(&self, succeeded: bool) {
+        if succeeded {
+            self.inner
+                .successful_requests
+                .fetch_add(1, Ordering::Relaxed);
+            self.inner.last_request_result.store(1, Ordering::Relaxed);
+        } else {
+            self.inner.failed_requests.fetch_add(1, Ordering::Relaxed);
+            self.inner.last_request_result.store(2, Ordering::Relaxed);
+        }
+    }
+
+    fn record_peer(&self) {
+        self.inner.peers_found.fetch_add(1, Ordering::Relaxed);
+    }
+}
