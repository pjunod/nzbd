+    use super::*;
+
+    #[test]
+    fn request_peers_health_tracks_current_run() {
+        let health = RequestPeersHealth::default();
+        assert_eq!(health.snapshot(), RequestPeersHealthSnapshot::default());
+
+        health.start();
+        health.record_request(false);
+        health.record_request(true);
+        health.record_peer();
+
+        assert_eq!(
+            health.snapshot(),
+            RequestPeersHealthSnapshot {
+                active: true,
+                successful_requests: 1,
+                failed_requests: 1,
+                peers_found: 1,
+                last_request_succeeded: Some(true),
+            }
+        );
+
+        health.stop();
+        assert!(!health.snapshot().active);
+
+        health.start();
+        assert_eq!(
+            health.snapshot(),
+            RequestPeersHealthSnapshot {
