+++ b/crates/librqbit/src/discovery_health.rs
@@ -0,0 +1,162 @@
+use dht::RequestPeersHealth;
+use serde::Serialize;
+use tracker_comms::TrackerHealth;
+use url::Url;
+
+pub use tracker_comms::{
+    TrackerFailure, TrackerFailureKind, TrackerHealthSnapshot, TrackerHealthState,
+};
+
+/// The observed state of DHT peer discovery for one torrent.
+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum DhtDiscoveryStatus {
+    /// DHT is disabled for the whole session.
+    Disabled,
+    /// The torrent is private, so DHT is intentionally suppressed.
+    SuppressedPrivate,
+    /// DHT is enabled, but this torrent has no active discovery stream.
+    Inactive,
+    /// Discovery is active and no DHT request has completed yet.
+    Searching,
+    /// The most recently completed DHT request succeeded.
+    Working,
+    /// The most recently completed DHT request failed.
+    Degraded,
+}
+
+/// A point-in-time view of one torrent's DHT peer discovery.
+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+pub struct DhtDiscoveryHealth {
+    pub status: DhtDiscoveryStatus,
+    pub successful_requests: u64,
+    pub failed_requests: u64,
+    pub peers_found: u64,
+}
+
+/// A credential-safe, point-in-time view of one torrent's peer discovery.
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub struct DiscoveryHealth {
+    pub dht: DhtDiscoveryHealth,
+    pub trackers: Vec<TrackerHealthSnapshot>,
+}
+
+#[derive(Clone, Debug)]
+enum DhtDiscoveryHealthSource {
+    Disabled,
+    SuppressedPrivate,
+    Enabled(RequestPeersHealth),
+}
+
+#[derive(Clone, Debug)]
+pub(crate) struct DiscoveryHealthHandle {
+    dht: DhtDiscoveryHealthSource,
+    trackers: TrackerHealth,
+}
+
+impl DiscoveryHealthHandle {
+    pub(crate) fn new<'a>(
+        dht_enabled: bool,
+        private: bool,
+        trackers: impl IntoIterator<Item = &'a Url>,
+    ) -> Self {
+        let dht = if private {
+            DhtDiscoveryHealthSource::SuppressedPrivate
+        } else if dht_enabled {
+            DhtDiscoveryHealthSource::Enabled(RequestPeersHealth::default())
+        } else {
+            DhtDiscoveryHealthSource::Disabled
+        };
+        Self {
+            dht,
+            trackers: TrackerHealth::new(trackers),
+        }
+    }
+
+    pub(crate) fn dht(&self) -> Option<RequestPeersHealth> {
+        match &self.dht {
+            DhtDiscoveryHealthSource::Enabled(health) => Some(health.clone()),
+            DhtDiscoveryHealthSource::Disabled | DhtDiscoveryHealthSource::SuppressedPrivate => {
+                None
+            }
+        }
+    }
+
+    pub(crate) fn trackers(&self) -> TrackerHealth {
+        self.trackers.clone()
+    }
+
+    pub(crate) fn snapshot(&self) -> DiscoveryHealth {
+        let dht = match &self.dht {
+            DhtDiscoveryHealthSource::Disabled => DhtDiscoveryHealth {
+                status: DhtDiscoveryStatus::Disabled,
+                successful_requests: 0,
+                failed_requests: 0,
+                peers_found: 0,
+            },
+            DhtDiscoveryHealthSource::SuppressedPrivate => DhtDiscoveryHealth {
+                status: DhtDiscoveryStatus::SuppressedPrivate,
+                successful_requests: 0,
+                failed_requests: 0,
+                peers_found: 0,
+            },
+            DhtDiscoveryHealthSource::Enabled(health) => {
+                let snapshot = health.snapshot();
+                let status = if !snapshot.active {
+                    DhtDiscoveryStatus::Inactive
+                } else {
+                    match snapshot.last_request_succeeded {
+                        None => DhtDiscoveryStatus::Searching,
+                        Some(true) => DhtDiscoveryStatus::Working,
+                        Some(false) => DhtDiscoveryStatus::Degraded,
+                    }
+                };
+                DhtDiscoveryHealth {
+                    status,
+                    successful_requests: snapshot.successful_requests,
+                    failed_requests: snapshot.failed_requests,
+                    peers_found: snapshot.peers_found,
+                }
+            }
+        };
+        DiscoveryHealth {
+            dht,
+            trackers: self.trackers.snapshot(),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tracker_endpoints_are_redacted_in_public_snapshot() {
+        let tracker = Url::parse(
+            "https://user:secret@tracker.example:8443/private/passkey/announce?token=secret",
+        )
+        .unwrap();
+        let health = DiscoveryHealthHandle::new(false, false, [&tracker]);
+
+        let snapshot = health.snapshot();
+        assert_eq!(snapshot.dht.status, DhtDiscoveryStatus::Disabled);
+        assert_eq!(snapshot.trackers.len(), 1);
+        assert_eq!(
+            snapshot.trackers[0].endpoint,
+            "https://tracker.example:8443/<redacted>"
+        );
+        let json = serde_json::to_string(&snapshot).unwrap();
+        assert!(!json.contains("user"));
+        assert!(!json.contains("secret"));
+        assert!(!json.contains("passkey"));
+    }
+
+    #[test]
+    fn private_torrent_reports_dht_suppression() {
+        let health = DiscoveryHealthHandle::new(true, true, std::iter::empty());
+        assert_eq!(
+            health.snapshot().dht.status,
+            DhtDiscoveryStatus::SuppressedPrivate
+        );
+    }
+}
