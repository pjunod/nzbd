+#[cfg(test)]
+mod health_tests {
+    use super::*;
+
+    #[tokio::test]
+    async fn http_failure_is_classified_without_exposing_tracker_secrets() {
+        let listener = tokio::net::TcpListener::bind((std::net::Ipv4Addr::LOCALHOST, 0))
+            .await
+            .unwrap();
+        let addr = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (socket, _) = listener.accept().await.unwrap();
+            let mut request = [0_u8; 4096];
+            let mut filled = 0;
+            while filled < request.len() {
+                socket.readable().await.unwrap();
+                match socket.try_read(&mut request[filled..]) {
+                    Ok(0) => break,
+                    Ok(read) => {
+                        filled += read;
+                        if request[..filled]
+                            .windows(4)
+                            .any(|window| window == b"\r\n\r\n")
+                        {
+                            break;
+                        }
+                    }
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => continue,
+                    Err(error) => panic!("error reading request: {}", error),
+                }
+            }
+            socket.writable().await.unwrap();
+            socket
+                .try_write(b"HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                .unwrap();
+        });
+        let tracker = Url::parse(&format!(
+            "http://user:secret@{addr}/private/passkey/announce?token=secret"
+        ))
+        .unwrap();
+        let health = TrackerHealth::new([&tracker]);
+        let (tx, _rx) = tokio::sync::mpsc::channel(1);
+        let comms = TrackerComms {
+            info_hash: Id20::default(),
+            peer_id: Id20::default(),
+            stats: Box::new(()),
+            force_tracker_interval: None,
+            tx,
+            tcp_listen_port: Some(4240),
+            reqwest_client: reqwest::Client::builder().no_proxy().build().unwrap(),
+            health,
+        };
+
+        let failure = comms.tracker_one_request_http(tracker).await.unwrap_err();
+        server.await.unwrap();
+        assert_eq!(failure.kind, TrackerFailureKind::HttpStatus);
+        assert_eq!(failure.message, "tracker returned HTTP 500");
+        assert!(!failure.message.contains("user"));
+        assert!(!failure.message.contains("secret"));
+        assert!(!failure.message.contains("passkey"));
+    }
+}
