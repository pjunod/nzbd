new file mode 100644
index 0000000000000000000000000000000000000000..8abbdc3c4969c1a7600cf9357cdbe2bae808e0d2
--- /dev/null
+++ b/crates/tracker_comms/src/tracker_health.rs
@@ -0,0 +1,281 @@
+use std::collections::BTreeMap;
+use std::fmt;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use parking_lot::RwLock;
+use serde::Serialize;
+use url::Url;
+
+/// The last observed state of one tracker monitor.
+#[derive(Clone, Copy, Debug, Default, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum TrackerHealthState {
+    #[default]
+    Inactive,
+    Announcing,
+    Working,
+    BackingOff,
+    Rejected,
+}
+
+/// A stable, credential-safe tracker failure category.
+#[derive(Clone, Copy, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum TrackerFailureKind {
+    UnsupportedScheme,
+    Resolve,
+    Timeout,
+    Transport,
+    HttpStatus,
+    Rejected,
+    InvalidResponse,
+    Internal,
+}
+
+/// A bounded tracker error containing no URL, response body, or credentials.
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub struct TrackerFailure {
+    pub kind: TrackerFailureKind,
+    pub message: String,
+}
+
+impl TrackerFailure {
+    pub(crate) fn new(kind: TrackerFailureKind, message: impl Into<String>) -> Self {
+        Self {
+            kind,
+            message: message.into(),
+        }
+    }
+
+    pub(crate) fn request(error: &reqwest::Error) -> Self {
+        if error.is_timeout() {
+            Self::new(TrackerFailureKind::Timeout, "tracker request timed out")
+        } else {
+            Self::new(TrackerFailureKind::Transport, "tracker transport failed")
+        }
+    }
+}
+
+impl fmt::Display for TrackerFailure {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for TrackerFailure {}
+
+/// A point-in-time, credential-safe view of one tracker monitor.
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+pub struct TrackerHealthSnapshot {
+    /// Scheme, host, and port only. Path, query, and userinfo are always redacted.
+    pub endpoint: String,
+    pub state: TrackerHealthState,
+    pub next_announce_in: Option<Duration>,
+    pub last_error: Option<TrackerFailure>,
+}
+
+#[derive(Clone, Debug)]
+struct TrackerHealthEntry {
+    endpoint: String,
+    state: TrackerHealthState,
+    next_announce_at: Option<Instant>,
+    last_error: Option<TrackerFailure>,
+}
+
+/// Shared tracker-monitor state for one torrent.
+#[derive(Clone, Default)]
+pub struct TrackerHealth {
+    // Full URLs remain private lookup keys. Debug is implemented below using
+    // only the credential-safe public snapshots.
+    inner: Arc<RwLock<BTreeMap<String, TrackerHealthEntry>>>,
+}
+
+impl fmt::Debug for TrackerHealth {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TrackerHealth")
+            .field("trackers", &self.snapshot())
+            .finish()
+    }
+}
+
+impl TrackerHealth {
+    pub fn new<'a>(trackers: impl IntoIterator<Item = &'a Url>) -> Self {
+        let health = Self::default();
+        health.configure(trackers);
+        health
+    }
+
+    pub fn snapshot(&self) -> Vec<TrackerHealthSnapshot> {
+        let now = Instant::now();
+        let mut snapshot = self
+            .inner
+            .read()
+            .values()
+            .map(|entry| TrackerHealthSnapshot {
+                endpoint: entry.endpoint.clone(),
+                state: entry.state,
+                next_announce_in: entry
+                    .next_announce_at
+                    .map(|deadline| deadline.saturating_duration_since(now)),
+                last_error: entry.last_error.clone(),
+            })
+            .collect::<Vec<_>>();
+        snapshot.sort_by(|a, b| a.endpoint.cmp(&b.endpoint));
+        snapshot
+    }
+
+    pub(crate) fn configure<'a>(&self, trackers: impl IntoIterator<Item = &'a Url>) {
+        let mut entries = self.inner.write();
+        *entries = trackers
+            .into_iter()
+            .map(|tracker| {
+                (
+                    tracker.as_str().to_owned(),
+                    TrackerHealthEntry {
+                        endpoint: safe_tracker_endpoint(tracker),
+                        state: TrackerHealthState::Inactive,
+                        next_announce_at: None,
+                        last_error: None,
+                    },
+                )
+            })
+            .collect();
+    }
+
+    fn update(&self, tracker: &Url, update: impl FnOnce(&mut TrackerHealthEntry)) {
+        if let Some(entry) = self.inner.write().get_mut(tracker.as_str()) {
+            update(entry);
+        }
+    }
+
+    pub(crate) fn announcing(&self, tracker: &Url) {
+        self.update(tracker, |entry| {
+            entry.state = TrackerHealthState::Announcing;
+            entry.next_announce_at = None;
+        });
+    }
+
+    pub(crate) fn working(&self, tracker: &Url, next_announce_in: Duration) {
+        self.update(tracker, |entry| {
+            entry.state = TrackerHealthState::Working;
+            entry.next_announce_at = Instant::now().checked_add(next_announce_in);
+            entry.last_error = None;
+        });
+    }
+
+    pub(crate) fn backing_off(&self, tracker: &Url, retry_in: Duration, error: TrackerFailure) {
+        self.update(tracker, |entry| {
+            entry.state = TrackerHealthState::BackingOff;
+            entry.next_announce_at = Instant::now().checked_add(retry_in);
+            entry.last_error = Some(error);
+        });
+    }
+
+    pub(crate) fn reject(&self, tracker: &Url, error: TrackerFailure) {
+        self.update(tracker, |entry| {
+            entry.state = TrackerHealthState::Rejected;
+            entry.next_announce_at = None;
+            entry.last_error = Some(error);
+        });
+    }
+
+    pub(crate) fn stop(&self) {
+        for entry in self.inner.write().values_mut() {
+            if entry.state != TrackerHealthState::Rejected {
+                entry.state = TrackerHealthState::Inactive;
+                entry.next_announce_at = None;
+            }
+        }
+    }
+}
+
+pub(crate) struct TrackerHealthActivityGuard(pub(crate) TrackerHealth);
+
+impl Drop for TrackerHealthActivityGuard {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
+
+pub(crate) fn safe_tracker_endpoint(url: &Url) -> String {
+    let host = match url.host() {
+        Some(url::Host::Domain(host)) => host.to_owned(),
+        Some(url::Host::Ipv4(host)) => host.to_string(),
+        Some(url::Host::Ipv6(host)) => format!("[{host}]"),
+        None => "<missing-host>".to_owned(),
+    };
+    let port = url
+        .port()
+        .map(|port| format!(":{port}"))
+        .unwrap_or_default();
+    format!("{}://{host}{port}/<redacted>", url.scheme())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn tracker_health_redacts_endpoint_and_retains_safe_failure() {
+        let tracker = Url::parse(
+            "https://user:secret@tracker.example:8443/private/passkey/announce?token=secret",
+        )
+        .unwrap();
+        let health = TrackerHealth::new([&tracker]);
+        let debug = format!("{health:?}");
+        assert!(debug.contains("https://tracker.example:8443/<redacted>"));
+        for secret in ["user", "secret", "passkey", "token="] {
+            assert!(!debug.contains(secret), "{} leaked through Debug", secret);
+        }
+
+        let initial = health.snapshot();
+        assert_eq!(initial.len(), 1);
+        assert_eq!(
+            initial[0].endpoint,
+            "https://tracker.example:8443/<redacted>"
+        );
+        assert_eq!(initial[0].state, TrackerHealthState::Inactive);
+
+        health.announcing(&tracker);
+        assert_eq!(health.snapshot()[0].state, TrackerHealthState::Announcing);
+
+        let failure =
+            TrackerFailure::new(TrackerFailureKind::Rejected, "tracker rejected announce");
+        health.backing_off(&tracker, Duration::from_secs(30), failure.clone());
+        let failed = health.snapshot();
+        assert_eq!(failed[0].state, TrackerHealthState::BackingOff);
+        assert_eq!(failed[0].last_error, Some(failure));
+        assert!(failed[0].next_announce_in.unwrap() <= Duration::from_secs(30));
+
+        health.stop();
+        let stopped = health.snapshot();
+        assert_eq!(stopped[0].state, TrackerHealthState::Inactive);
+        assert!(stopped[0].next_announce_in.is_none());
+        assert_eq!(
+            stopped[0].last_error.as_ref().unwrap().message,
+            "tracker rejected announce"
+        );
+    }
+
+    #[test]
+    fn unsupported_tracker_remains_rejected_when_other_monitors_stop() {
+        let tracker = Url::parse("ws://tracker.example/private?token=secret").unwrap();
+        let health = TrackerHealth::new([&tracker]);
+        health.reject(
+            &tracker,
+            TrackerFailure::new(
+                TrackerFailureKind::UnsupportedScheme,
+                "tracker scheme is unsupported",
+            ),
+        );
+        health.stop();
+
+        let snapshot = health.snapshot();
+        assert_eq!(snapshot[0].state, TrackerHealthState::Rejected);
+        assert_eq!(
+            snapshot[0].last_error.as_ref().unwrap().kind,
+            TrackerFailureKind::UnsupportedScheme
+        );
+    }
+}
