#!/usr/bin/env sh
# The core Rust gate before anything leaves the machine. Specialized CI
# workflows add platform, fuzz, supply-chain, and integration checks.
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -e

echo "pre-push: cargo clippy (deny warnings)"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: cargo test --workspace"
cargo test --workspace
