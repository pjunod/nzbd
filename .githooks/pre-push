#!/usr/bin/env sh
# Keep pushes cheap while a substantial branch is under construction. The
# merge-candidate `make fast-check` owns tests after the one combined review.
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -e

echo "pre-push: cargo fmt --all --check"
cargo fmt --all --check

echo "pre-push: cargo check --workspace --all-targets"
cargo check --workspace --all-targets
